{
	"name": "obsidian-document-versioning",
	"version": "1.12.0",
	"author": "NuLegal",
	"description": "Version Obsidian documents through safe GitHub branches, reviews, and document history.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test tests/*.test.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"document-versioning",
		"github"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nulegal-startup/obsidian-document-versioning.git"
	},
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.8",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.28.2",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"set-interval-async": "^3.0.3",
		"simple-git": "^3.36.0"
	}
}
